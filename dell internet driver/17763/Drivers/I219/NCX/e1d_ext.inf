;*******************************************************************************
; Extension INF for Intel(R) PCIe Network Adapters
;*******************************************************************************
;
[Version]
Signature   = "$WINDOWS NT$"
Class       = Extension
ClassGuid   = {e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider    = %Provider%
ExtensionId = {EFFB1195-DAD6-47D0-BDEE-D61A4BE72407} ; This is an Intel GUID; please replace with your own GUID
DriverVer   = 01/29/2026,1.0.0.5
CatalogFile = e1d_ext.cat

[Manufacturer]
; %Provider% = OEM, NTx86.10.0, NTamd64.10.0
%Provider% = OEM, NTamd64.10.0...22000
%Provider% = OEM, NTx86.10.0...22000

[OEM.NTamd64.10.0...22000]
; HWID Models directives for x64 go here, e.g.:
;%Provider.ExtensionDesc% = HWIDInstall.10.0, PCI\VEN_8086&DEV_XXXX&SUBSYS_XXXXXXXX
%Provider.ExtensionDesc% = HWIDInstall.10.0, PCI\VEN_8086&DEV_57A0,
%Provider.ExtensionDesc% = HWIDInstall2.10.0, PCI\VEN_8086&DEV_550A,
%Provider.ExtensionDesc% = HWIDInstall2.10.0, PCI\VEN_8086&DEV_550C,
%Provider.ExtensionDesc% = HWIDInstall2.10.0, PCI\VEN_8086&DEV_550E,

[OEM.NTx86.10.0...22000]
; HWID Models directives for x64 go here, e.g.:
;%Provider.ExtensionDesc% = HWIDInstall.10.0, PCI\VEN_8086&DEV_XXXX&SUBSYS_XXXXXXXX
%Provider.ExtensionDesc% = HWIDInstall.10.0, PCI\VEN_8086&DEV_57A0,
%Provider.ExtensionDesc% = HWIDInstall2.10.0, PCI\VEN_8086&DEV_550A,
%Provider.ExtensionDesc% = HWIDInstall2.10.0, PCI\VEN_8086&DEV_550C,
%Provider.ExtensionDesc% = HWIDInstall2.10.0, PCI\VEN_8086&DEV_550E,

[HWIDInstall.10.0]
; DDInstall directives go here, e.g.:
AddReg = Customizations.AddReg
AddReg = Plllocktimeout.AddReg

[HWIDInstall2.10.0]
; DDInstall directives go here, e.g.:
AddReg = Plllocktimeout.AddReg

[HWIDInstall.10.0.HW]
; Include directives go here, e.g.:
Include            = pci.inf
Needs              = PciIoSpaceNotRequired.HW
;AddReg             = MSI.reg

[Customizations.AddReg]
; The default values are specified here. Change default values to customize behavior.
HKR,, EnableK1, 0, "1"

[Plllocktimeout.AddReg]
; The default values are specified here. Change default values to customize behavior.
HKR,, "Plllocktimeout", 0x00010001, 0x1d5

[Strings]
Provider               = "OEM" ; Replace with your provider name
Provider.ExtensionDesc = "OEM Extensions for Intel(R) Ethernet Controller"
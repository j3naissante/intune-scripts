*PhysicalMediaType = 14 ; NdisPhysicalMedium802_3

[I219.19H1.Services]
AddService = e1dexpress, 2, winblue.Service, winblue.EventLog

[I219.19H1.HW]
Include            = pci.inf
Needs              = PciIoSpaceNotRequired.HW
AddReg             = MSI.reg

;-------------------------------------------------------------------------------

; Intel(R) Ethernet Connection (18) I219-LM

; Intel(R) Ethernet Connection (20) I219-LM

; Intel(R) Ethernet Connection (24) I219-LM

; Intel(R) Ethernet Connection (25) I219-LM

; Intel(R) Ethernet Connection (27) I219-LM
;-------------------------------------------------------------------------------
[I219_NOK1.19H1]
Characteristics    = 0x84 ; NCF_HAS_UI | NCF_PHYSICAL
BusType            = 5    ; PCI
DelReg             = Advanced.DelReg
AddReg             = e1d.reg, TcpSeg.reg, JumboPacket.reg, SVOFFMode.reg
AddReg             = Copper.reg, Copper1000.reg, Autoneg10100.reg
AddReg             = AcDcLink.reg
AddReg             = Powermgmt.reg, WakeOnSlot.reg
AddReg             = Sips.reg
AddReg             = Po.reg
AddReg             = EEE.reg
AddReg             = ulp.reg
AddReg             = disableK1.reg
AddReg             = UninstallW2.reg
AddReg             = CoInKS.reg
AddReg             = NDISVlanId.reg
AddReg             = PtpHardwareTimestamp.reg
AddReg             = SoftwareTimestamp.reg
CopyFiles          = winblue.CopyFiles, MessageDll.CopyFiles
*IfType            = 6    ; IF_TYPE_ETHERNET_CSMACD
*MediaType         = 0    ; NdisMedium802_3
*PhysicalMediaType = 14 ; NdisPhysicalMedium802_3

[I219_NOK1.19H1.Services]
AddService = e1dexpress, 2, winblue.Service, winblue.EventLog

[I219_NOK1.19H1.HW]
